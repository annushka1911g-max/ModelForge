# ==============================================================================
# ModelForge Environment Configuration Template (.env.example)
# Copy this file to .env and fill in secure values before starting the services.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=ModelForge
API_V1_STR=/api/v1

# Security & Authentication (JWT)
# Generate a secure random string: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=modelforge_user
POSTGRES_PASSWORD=modelforge_secure_password_placeholder
POSTGRES_DB=modelforge_db
DATABASE_URL=postgresql://modelforge_user:modelforge_secure_password_placeholder@postgres:5432/modelforge_db

# MinIO (S3-Compatible Object Storage) Configuration
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_admin_password_placeholder
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_BATCH=batch-jobs
MINIO_USE_SSL=False

# Model Serving & Runtime Configuration
MODEL_CACHE_MAX_SIZE=5
MODEL_STORAGE_DIR=/tmp/modelforge/models_cache

# Monitoring & Telemetry
PROMETHEUS_METRICS_ENABLED=True
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_secure_admin_password_placeholder

# Frontend Configuration
VITE_API_BASE_URL=http://localhost/api/v1
